# OndoPerpsMM — ondo1 account template.
# Copy this file to `.env` (same directory) and fill in the credentials below.

# --- OndoPerps API endpoint ------------------------------------------------
ONDO_REST_BASE_URL=https://api.ondoperps.xyz
ONDO_WS_URL=wss://api.ondoperps.xyz/ws

# --- API credentials -------------------------------------------------------
# Generate via the OndoPerps web UI: Settings -> API Keys -> Add New API Key.
# The key id is shown with an "ondoKeyId_" prefix; the secret is shown ONCE
# with an "ondoApiSecret_" prefix. Paste both verbatim including prefixes.
# Optional: IP-whitelist up to 16 addresses on the key for extra safety.
ONDO_KEY_ID=ondoKeyId_406cd2369a7b913ca7de3705fc57516b
ONDO_API_SECRET=ondoApiSecret_e3c22f364c5bba977fd29767488ea39322aad01cb79236ee2ff89484049eb258

# --- Markets to trade ------------------------------------------------------
# CSV of OndoPerps ticker strings. Format: <BASE>-USD.P (no spaces).
#
# All 22 currently listed:
#   Stocks (16): AAPL-USD.P, AMD-USD.P, AMZN-USD.P, COIN-USD.P, CRCL-USD.P,
#                GOOGL-USD.P, HOOD-USD.P, INTC-USD.P, META-USD.P, MSFT-USD.P,
#                MSTR-USD.P, NFLX-USD.P, NVDA-USD.P, ORCL-USD.P, PLTR-USD.P,
#                TSLA-USD.P
#   Indices (2): US500-USD.P, US100-USD.P
#   Commodities (3): XAU-USD.P, XAG-USD.P, WTI-USD.P
#   ETF (1):     DRAM-USD.P
#
# Suggested starter set (most liquid stocks + indices + gold) for a first
# live test — small enough to deploy quickly, broad enough to surface most
# bugs:
PAIRS_INCLUDE=AAPL-USD.P,NVDA-USD.P,TSLA-USD.P,MSFT-USD.P,META-USD.P,US500-USD.P,US100-USD.P,XAU-USD.P

# --- Strategy / risk knobs (all optional — defaults shown) -----------------
# Calibrated for OndoPerps's 1.5 bp maker fee: grid step ≥ 15 bp keeps
# theoretical round-trip edge positive after fees + a few bp of adverse
# selection. Tighten with caution.
# ORDER_SIZE_USD=50
# LEVELS_PER_SIDE=1
# GRID_STEP_BP=15
# MAX_NOTIONAL_PER_PAIR_USD=100
# MAX_TOTAL_NOTIONAL_USD=2000
# REQUOTE_DRIFT_BP=20
# SESSION_DD_LIMIT_USD=-10
# PAIR_STOP_LOSS_USD=-1.5

# --- Bot mode --------------------------------------------------------------
# TRADING=true → live orders. TRADING=false → dry-run (logged but not sent).
TRADING=false
